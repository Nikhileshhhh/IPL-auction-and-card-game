# STUMPS environment template. Names and safe placeholders only — never commit real values.
# Local development: run `pnpm setup:env` to generate /.env and apps/web/.env.local with fresh secrets.
# Generate a secret manually: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- API server (apps/server, Render) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://app_runtime:change-me@127.0.0.1:54329/stumps
DATABASE_POOL_MAX=5
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
AUTH_REDIRECT_ORIGIN=http://localhost:3000

# Secrets (base64url, >= 32 bytes; DATA_ENCRYPTION_KEY_V1 exactly 32 bytes). Unique per environment.
BFF_SIGNING_KEY=replace-me
ACCESS_CODE_PEPPER_V1=replace-me
ROOM_PASSWORD_PEPPER_V1=replace-me
INVITE_LOOKUP_HMAC_KEY=replace-me
DATA_ENCRYPTION_KEY_V1=replace-me

# --- Auth adapter (ADR-005/016). Production must use supabase. ---
AUTH_PROVIDER=local
# Local dev/test only: >= 32 random characters
LOCAL_AUTH_JWT_SECRET=replace-with-32-plus-random-characters-local-only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PUBLISHABLE_KEY=replace-me
# Highly privileged; API server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# --- Migrations / operator scripts only (never runtime) ---
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/stumps

# --- Web server (apps/web, Vercel). Server-only unless prefixed NEXT_PUBLIC_ ---
INTERNAL_API_URL=http://127.0.0.1:4000
# Same value as the API's BFF_SIGNING_KEY
# BFF_SIGNING_KEY=replace-me
CSRF_SIGNING_KEY=replace-me
# Vercel provides x-real-ip; use none for local development
CLIENT_IP_HEADER=x-real-ip
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Media and data (API server) ---
# Player portraits are private: local disk in development, Supabase Storage in production.
MEDIA_STORAGE=local
MEDIA_DIR=.local/media
MEDIA_BUCKET=catalog-media
# Where scripts/data/fetch-cricsheet.ts stores the IPL archive (gitignored).
CRICSHEET_DIR=data/raw/cricsheet
# Licensed photo source(s) for the player sheet importer, e.g. your licensed image CDN host.
PHOTO_IMPORT_HOSTS=
