# STUMPS environment template. Names and safe placeholders only — never commit real values.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- API server (apps/server, Render) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://app_runtime:change-me@127.0.0.1:54329/stumps
DATABASE_POOL_MAX=5
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# --- Migrations / CI only (never runtime) ---
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/stumps

# --- Web server (apps/web, Vercel). Server-only unless prefixed NEXT_PUBLIC_ ---
INTERNAL_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
