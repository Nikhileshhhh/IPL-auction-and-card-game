{
  "name": "stumps",
  "private": true,
  "version": "0.1.0",
  "description": "STUMPS — private cricket card battle and mega-auction platform",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @stumps/server --filter @stumps/web dev",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.tests.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:concurrency": "vitest run --project concurrency",
    "test:e2e": "playwright test",
    "test:load": "tsx tests/load/run.ts",
    "build": "pnpm -r build",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:lint": "tsx scripts/db/lint.ts",
    "contracts:check": "tsx scripts/verify-contracts/index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "16.5.0",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "sharp"
    ]
  }
}
