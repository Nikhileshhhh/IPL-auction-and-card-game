{
  "$comment": "Outbound event registry (DB/realtime §3.1, §8.3). Every event envelope: eventId, schemaVersion, type, streamId, seq, roomStateVersion, occurredAt, payload. Audiences: room = public-to-room stream; team = team:{franchiseId}; member = member:{membershipId}; socket = personalized, not persisted to a stream.",
  "specVersion": "1.0",
  "envelope": ["eventId", "schemaVersion", "type", "streamId", "seq", "roomStateVersion", "occurredAt", "payload"],
  "events": {
    "room.snapshot":              { "audience": "socket", "payload": ["room", "me", "capabilities", "gameProjection", "presence", "cursors", "serverNow"] },
    "room.memberJoined":          { "audience": "room",   "payload": ["memberId", "displayName", "seat", "connectionStatus"] },
    "room.memberLeft":            { "audience": "room",   "payload": ["memberId", "displayName", "seat", "connectionStatus"] },
    "room.memberRemoved":         { "audience": "room",   "payload": ["memberId", "displayName", "seat", "connectionStatus"] },
    "room.settingsChanged":       { "audience": "room",   "payload": ["configVersion", "settings"] },
    "room.readinessChanged":      { "audience": "room",   "payload": ["configVersion", "memberId", "ready"] },
    "room.hostTransferred":       { "audience": "room",   "payload": ["configVersion", "hostId"] },
    "room.hostHandoverProposed":  { "audience": "member", "payload": ["handoverId", "fromMemberId", "expiresAt"] },
    "game.started":               { "audience": "room",   "payload": ["stateVersion", "seedCommitment", "dataVersion", "rulesHash"] },
    "card.roundOpened":           { "audience": "room",   "payload": ["comparisonId", "comparisonIndex", "chainIndex", "eligibleSeats", "selector", "visibleCards", "allowedMetrics", "deadline", "potCount", "tie"] },
    "card.comparisonResolved":    { "audience": "room",   "payload": ["comparisonId", "metric", "byTimeout", "submittedValues", "tiedSeats", "winnerId?", "reason", "fallback?"] },
    "card.potChanged":            { "audience": "room",   "payload": ["potCount", "awardedTo?", "awardedCount", "deckCounts"] },
    "card.playerEliminated":      { "audience": "room",   "payload": ["memberId", "eliminationOrder", "reason"] },
    "team.created":               { "audience": "room",   "payload": ["franchiseId", "franchiseDefinitionId", "captainMemberId"] },
    "team.joinRequested":         { "audience": "team",   "payload": ["requestId", "memberId", "displayName"] },
    "team.membershipChanged":     { "audience": "team",   "payload": ["memberId", "role", "approved", "epoch"] },
    "team.permissionsChanged":    { "audience": "team",   "payload": ["memberId", "role", "capabilities", "version"] },
    "team.inviteChanged":         { "audience": "team",   "payload": ["expiresAt", "autoJoinUserIds"] },
    "team.captainProposed":       { "audience": "team",   "payload": ["handoverId", "fromMemberId", "toMemberId", "expiresAt"] },
    "team.captainChanged":        { "audience": "team",   "payload": ["memberId", "role", "approved", "epoch"] },
    "team.controlChanged":        { "audience": "team",   "payload": ["mode", "epoch", "reasonCode"] },
    "team.autoDecision":          { "audience": "team",   "payload": ["mode", "epoch", "reasonCode", "decision", "ceiling?"] },
    "team.autoConfigured":        { "audience": "team",   "payload": ["strategyVersion", "enabled"] },
    "team.shortlistChanged":      { "audience": "team",   "payload": ["entries"] },
    "team.shortlistVoteChanged":  { "audience": "team",   "payload": ["playerId", "tally"] },
    "team.retentionProposed":     { "audience": "team",   "payload": ["packageId", "version", "playersAndAllocations", "totalCharge"] },
    "auction.retentionLocked":    { "audience": "room",   "payload": ["franchiseId", "retainedPlayerIds", "retentionCharge", "remainingPurse"] },
    "auction.setupPhaseChanged":  { "audience": "room",   "payload": ["phase"] },
    "auction.playerNominated":    { "audience": "room",   "payload": ["playerPublicDTO", "basePrice", "nominationId", "bidVersion", "deadline"] },
    "auction.biddingOpened":      { "audience": "room",   "payload": ["playerPublicDTO", "basePrice", "nominationId", "bidVersion", "deadline"] },
    "auction.bidAccepted":        { "audience": "room",   "payload": ["nominationId", "franchiseId", "amountRupees", "nominationVersion", "deadline", "actorType"] },
    "auction.timerChanged":       { "audience": "room",   "payload": ["nominationId", "deadline", "generation"] },
    "auction.playerSold":         { "audience": "room",   "payload": ["playerId", "outcome", "franchiseId", "price", "publicPursesAndCounts"] },
    "auction.playerUnsold":       { "audience": "room",   "payload": ["playerId", "outcome", "publicPursesAndCounts"] },
    "auction.playerSkipped":      { "audience": "room",   "payload": ["playerId", "outcome"] },
    "auction.rtmStageChanged":    { "audience": "room",   "payload": ["stage", "eligibleFranchiseId", "standingBid", "deadline"] },
    "auction.paused":             { "audience": "room",   "payload": ["reason", "phase", "deadline?", "generation"] },
    "auction.resumed":            { "audience": "room",   "payload": ["reason", "phase", "deadline?", "generation"] },
    "presence.changed":           { "audience": "room",   "payload": ["memberId", "status", "lastSeenApprox"] },
    "member.controlChanged":      { "audience": "member", "payload": ["newEpoch", "controllerConnectionId"] },
    "vote.started":               { "audience": "room",   "payload": ["voteId", "startsAt", "expiresAt", "electorateCount", "threshold", "canVote"] },
    "vote.recorded":              { "audience": "member", "payload": ["voteId", "choice", "receiptId"] },
    "vote.resolved":              { "audience": "room",   "payload": ["voteId", "yes", "no", "abstain", "passed", "resumedPhase?", "deadline?"] },
    "chat.message":               { "audience": "channel","payload": ["channelId", "messageId", "sender", "text", "createdAt"] },
    "chat.removed":               { "audience": "channel","payload": ["channelId", "messageId", "removed", "createdAt"] },
    "chat.muted":                 { "audience": "member", "payload": ["channelId", "expiresAt", "reason"] },
    "game.finalizing":            { "audience": "room",   "payload": ["stage", "progressPercent", "reason", "deadline"] },
    "game.evaluationProgress":    { "audience": "room",   "payload": ["stage", "progressPercent"] },
    "game.completed":             { "audience": "room",   "payload": ["publicResult", "medalStatus", "resultsExpiresAt", "auditSeed", "rngVersion"] },
    "room.expiring":              { "audience": "room",   "payload": ["expiresAt", "reason", "profileUrl"] },
    "room.closed":                { "audience": "room",   "payload": ["expiresAt", "reason", "profileUrl"] },
    "auth.revoked":               { "audience": "socket", "payload": ["reason", "reverifyUrl?"] },
    "control.revoked":            { "audience": "socket", "payload": ["reason", "newEpoch?"] },
    "server.recovering":          { "audience": "socket", "payload": ["reason", "reconnectAfterMs", "recoveryGeneration"] }
  },
  "versionBehavior": {
    "schemaVersion": "Integer per event type; additive fields keep the version, breaking changes bump it and the server emits both versions during expand/contract rollout.",
    "streamSeq": "bigint decimal string, contiguous per stream; clients ignore seq <= cursor and request replay on gap.",
    "replayLimit": { "maxEvents": 500, "maxBytes": 262144, "overflow": "snapshotRequired" },
    "roomStateVersion": "Incremented by gameplay transitions only; chat/presence never change it."
  }
}
